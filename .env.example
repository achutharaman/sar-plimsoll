# Local offline defaults (no GCP needed)
PLIMSOLL_STORE_BACKEND=memory
PLIMSOLL_QUEUE_BACKEND=inline
PLIMSOLL_LLM_BACKEND=fake
PLIMSOLL_AUTH_MODE=dev

# Against a real project (after `gcloud auth application-default login`)
# PLIMSOLL_GCP_PROJECT=your-project-id
# PLIMSOLL_GCP_REGION=us-central1
# PLIMSOLL_STORE_BACKEND=gcp
# PLIMSOLL_LLM_BACKEND=vertex
# PLIMSOLL_GCS_BUCKET=your-project-id-plimsoll-sources
# PLIMSOLL_BQ_DATASET=plimsoll
